# =====================================================================
# Plantilla de entorno de PRODUCCIÓN — InfinityFree (MySQL)
# Copiá este archivo como `.env` en el servidor y completá los valores
# marcados con <...> usando los datos del panel de InfinityFree.
# NO subas este archivo con valores reales a git.
# =====================================================================

APP_NAME="Finanzas Personales"
APP_ENV=production
# Generá una clave nueva en tu máquina con:  php artisan key:generate --show
APP_KEY=<PEGAR_APP_KEY_GENERADA>
APP_DEBUG=false
APP_URL=https://<tu-subdominio>.infinityfreeapp.com
APP_TIMEZONE=America/Santiago

# Dominio del frontend en Vercel (sin barra final). Separá múltiples con coma.
CORS_ALLOWED_ORIGINS=https://<tu-app>.vercel.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

# Logs: solo errores en producción
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Base de datos: MySQL de InfinityFree (datos en panel > MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=<sqlXXX.infinityfree.com>
DB_PORT=3306
DB_DATABASE=<if0_XXXXXXX_finanzas>
DB_USERNAME=<if0_XXXXXXX>
DB_PASSWORD=<password_del_panel>

# Shared hosting: SIN worker de colas. 'sync' ejecuta los jobs en el request.
QUEUE_CONNECTION=sync

# La tabla sessions y cache ya existen (migradas). 'database' funciona.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail: dejar en log salvo que configures SMTP propio
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@finanzas.app"
MAIL_FROM_NAME="${APP_NAME}"
