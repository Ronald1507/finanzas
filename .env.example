# ── Database ──────────────────────────────────────────────────────────────────
# Modo A — BD LOCAL (Docker levanta el contenedor postgres junto con la app)
#   Comando: docker compose --profile local-db up
#   No es necesario definir DB_HOST; el default apunta al servicio interno.
#
# Modo B — BD EXTERNA (el contenedor postgres NO se levanta)
#   Comando: docker compose up
#   Definir las variables de abajo con los datos del servidor remoto.

DB_HOST=tu-servidor.ejemplo.com
DB_PORT=5432
DB_DATABASE=finanzas
DB_USERNAME=finanzas
DB_PASSWORD=cambia_esto

# ── Backend ───────────────────────────────────────────────────────────────────
APP_KEY=                          # generar con: php artisan key:generate
BACKEND_URL=http://localhost:8000

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:8000
